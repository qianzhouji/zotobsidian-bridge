{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.mjs",
    "../src/adapters/companion-protocol.ts",
    "../src/core/markdown.ts",
    "../src/core/note-content.ts",
    "../src/core/models.ts"
  ]
}
